# ============================================
# VARIABLES DE ENTORNO — CYBERSECURITY HOME LAB
# ============================================
# Copia este archivo como .env y edita los valores
# NUNCA subas el archivo .env a GitHub
# cp .env.example .env

# ── PI-HOLE ──────────────────────────────────
# Contraseña para el panel de administración
WEBPASSWORD=cambiar_esto

# DNS upstream (puedes usar otros como 9.9.9.9)
PIHOLE_DNS_=8.8.8.8,1.1.1.1

# IP local de tu Raspberry Pi
FTLCONF_LOCAL_IPV4=192.168.1.X

# Zona horaria — ver lista en: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Madrid
